@model IEnumerable<TodoAppKozmos.Core.Models.Todo>

@{
ViewData["Title"] = "Todo List";
}

<div class="container mt-5">
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold">Todo List</h1>
        <p class="text-muted mb-0">
            Yapılacak işlerinizi buradan yönetebilirsiniz.
        </p>
    </div>

    <a asp-controller="Todo"
       asp-action="Create"
       class="btn btn-primary">
        + Yeni Todo
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        Henüz bir Todo bulunmuyor.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover mb-0 align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Başlık</th>
                            <th>Açıklama</th>
                            <th>Durum</th>
                            <th>Oluşturulma</th>
                            <th>Son Tarih</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var todo in Model)
                    {
                        <tr>

                            <td>
                                @todo.Id
                            </td>

                            <td>
                                @if (todo.IsCompleted)
                                {
                                    <span class="text-decoration-line-through text-muted">
                                        @todo.Title
                                    </span>
                                }
                                else
                                {
                                    <strong>
                                        @todo.Title
                                    </strong>
                                }
                            </td>

                            <td>
                                @if (string.IsNullOrWhiteSpace(todo.Description))
                                {
                                    <span class="text-muted">
                                        Açıklama yok
                                    </span>
                                }
                                else
                                {
                                    @todo.Description
                                }
                            </td>

                            <td>
                                @if (todo.IsCompleted)
                                {
                                    <span class="badge bg-success">
                                        Tamamlandı
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Bekliyor
                                    </span>
                                }
                            </td>

                            <td>
                                @todo.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                            </td>

                            <td>
                                @if (todo.DueDate.HasValue)
                                {
                                    @todo.DueDate.Value.ToString("dd.MM.yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">
                                        -
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="d-flex justify-content-center gap-1">

                                    <!-- Complete -->
                                    <form asp-controller="Todo"
                                          asp-action="Complete"
                                          asp-route-id="@todo.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        @if (todo.IsCompleted)
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-secondary">
                                                Geri Al
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success">
                                                Tamamla
                                            </button>
                                        }

                                    </form>

                                    <!-- Edit -->
                                    <a asp-controller="Todo"
                                       asp-action="Edit"
                                       asp-route-id="@todo.Id"
                                       class="btn btn-sm btn-outline-warning">
                                        Düzenle
                                    </a>

                                    <!-- Delete -->
                                    <form asp-controller="Todo"
                                          asp-action="Delete"
                                          asp-route-id="@todo.Id"
                                          method="post"
                                          onsubmit="return confirm('Bu Todo silinsin mi?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Sil
                                        </button>

                                    </form>

                                </div>
                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>

        </div>
    </div>
}

</div>